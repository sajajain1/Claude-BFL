# ModernizeAI configuration — copy to .env (never commit .env) and export before starting the backend:
#   set -a; source .env; set +a; cd backend && mvn spring-boot:run
#
# All values are optional. Without ANTHROPIC_API_KEY the scanner works fully; only Claude explanations are disabled.

# Anthropic API key from https://console.anthropic.com (billed separately from Claude.ai chat plans).
ANTHROPIC_API_KEY=

# Claude model id. Default: claude-opus-5-5. A cheaper option: claude-haiku-5-5.
ANTHROPIC_MODEL=

# Backend HTTP port. Default: 8080.
PORT=8080

# Comma-separated origins allowed to call the API from a browser (only needed if the UI is hosted elsewhere).
MODERNIZEAI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend only: base URL of the backend when the UI is not served by the backend or the Vite proxy.
# VITE_API_BASE=https://your-backend.example.com
